{
  "name": "pricemyprang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed-admin": "dotenv -e .env.local -- tsx scripts/seed-admin.ts",
    "db:seed-insurers": "dotenv -e .env.local -- tsx scripts/seed-insurers.ts",
    "blob:list": "dotenv -e .env.local -- tsx scripts/list-blobs.ts",
    "activity:check": "dotenv -e .env.local -- tsx scripts/check-activity-log.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.5.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
