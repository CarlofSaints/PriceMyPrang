// ---------------------------------------------------------------------------
// Price my Prang — relational schema (Neon Postgres).
//
// Structured records live here; BYTES stay in Vercel Blob. Media rows store the
// blob pathname + the /api/media proxy URL, never the file itself.
//
// Deliberately normalised (quote lines and media are real tables, vehicle
// fields are real columns) because Power BI is a first-class consumer and
// handles JSONB badly. Only genuinely opaque text (OCR output) stays freeform.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums -----------------------------------------------------------------

enum RateUnit {
  rand_per_hour
  rand
  percent
}

/// Blocks within a rate card. Fields inside each live in lib/rateCard.ts.
enum RateScope {
  in_warranty
  out_of_warranty
  aluminium
  general
}

/// How a job is funded — "cash" means the client pays directly.
enum RateCardKind {
  cash
  insurance
}

/// Whose org chart a role belongs to.
enum RoleScope {
  platform
  panel_beater
}

/// The repairer agreement (T&Cs / NDA / SLA) a Super Admin uploads. Exactly one
/// is active; superseded ones are kept because signatures point at the version
/// that was actually agreed to.
model AgreementDocument {
  id        String  @id @default(uuid())
  title     String
  /// HTML converted from the uploaded .docx, rendered on the signing page.
  html      String
  /// The original file, kept so the source of truth can be downloaded.
  sourceUrl      String
  sourcePathname String
  active         Boolean @default(true)

  uploadedByName String?
  createdAt      DateTime @default(now())

  signatures RepairerAgreement[]

  @@index([active])
  @@map("agreement_documents")
}

/// One repairer's acceptance. Created unsigned at registration so the emailed
/// link has something to point at; `signedAt` is what makes it an agreement.
model RepairerAgreement {
  id            String @id @default(uuid())
  panelBeaterId String
  documentId    String

  /// Unguessable key for the emailed signing link.
  token String @unique

  /// Who we sent it to, captured at registration.
  sentToName  String
  sentToEmail String

  // Filled in on signing. An ordinary electronic signature: the typed name
  // plus what we can observe about the act of signing.
  signedAt        DateTime?
  signerName      String?
  signerTitle     String?
  signerIp        String?
  signerUserAgent String?
  /// The countersigned PDF handed to both parties.
  pdfUrl          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelBeater PanelBeater       @relation(fields: [panelBeaterId], references: [id], onDelete: Cascade)
  document    AgreementDocument @relation(fields: [documentId], references: [id])

  @@index([panelBeaterId])
  @@map("repairer_agreements")
}

enum PartType {
  new
  used
  alternate
}

enum PanelBeaterStatus {
  pending
  approved
  declined
}

enum RequestStatus {
  new
  in_progress
  completed
}

/// Where a single workshop's quote stands with the CONSUMER. Nothing to do with
/// PanelBeaterStatus, which is whether we've vetted the workshop itself.
enum QuoteStatus {
  awaiting_approval
  accepted
  declined
}

enum YesNo {
  yes
  no
}

enum YesNoUnsure {
  yes
  no
  unsure
}

/// Which slot a piece of request media fills. The four `photo_*` kinds are the
/// mandatory full-vehicle shots; `damage` is the optional close-up set.
enum MediaKind {
  disc
  odometer
  video
  photo_front
  photo_back
  photo_left
  photo_right
  damage
}

// ---- Access control --------------------------------------------------------

/// Roles stay DATA (edited in the portal). Permission keys are code-defined in
/// lib/permissions.ts and held here as a plain text[].
model Role {
  id          String    @id
  name        String
  permissions String[]
  system      Boolean   @default(false)
  /// Whether this role belongs to PMP staff or to a panel beater's own team.
  /// A workshop admin may only ever assign panel_beater-scoped roles.
  scope       RoleScope @default(platform)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  name String
  /// Stored lower-cased so uniqueness is genuinely case-insensitive.
  email        String  @unique
  passwordHash String
  active       Boolean @default(true)

  /// Set when an admin issues a temporary password. The portal shows nothing
  /// but the change-password screen until the user picks their own.
  mustChangePassword Boolean @default(false)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  /// Set when this login belongs to a panel beater editing their own listing.
  panelBeaterId String?
  panelBeater   PanelBeater? @relation(fields: [panelBeaterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([panelBeaterId])
  @@map("users")
}

// ---- Rate cards ------------------------------------------------------------

/// Insurers a CONSUMER can pick from when requesting a quote. Deliberately no
/// rate card: rates are negotiated per repairer (see RateCard.insurerName), so
/// there is no such thing as a central rate for an insurer.
model Insurer {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests QuoteRequest[]

  @@map("insurers")
}

/// One set of rates a workshop quotes on: their cash rates, or the rates they
/// have agreed with a particular insurer. Every repairer negotiates its own SLA,
/// so two workshops on the same street hold different numbers for the same
/// insurer — which is why the name is free text on the card rather than a link
/// to a shared, centrally-priced insurer.
model RateCard {
  id            String       @id @default(uuid())
  panelBeaterId String
  kind          RateCardKind
  /// Free-text insurance company name. Set only when kind is insurance.
  insurerName   String?
  /// Whether the optional aluminium block applies to this card.
  aluminium     Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelBeater PanelBeater     @relation(fields: [panelBeaterId], references: [id], onDelete: Cascade)
  values      RateCardValue[]
  requests    QuoteRequest[]

  /// One cash card, and one card per insurer name. Postgres treats NULLs as
  /// distinct, so the single cash card is additionally guarded in code.
  @@unique([panelBeaterId, insurerName])
  @@index([panelBeaterId])
  @@map("rate_cards")
}

/// A single rate on a card. Normalised rather than JSON because Power BI is a
/// first-class consumer of this database.
model RateCardValue {
  rateCardId String
  scope      RateScope
  field      String
  value      Decimal   @db.Decimal(12, 2)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@id([rateCardId, scope, field])
  @@map("rate_card_values")
}

// ---- Panel beaters ---------------------------------------------------------

model PanelBeater {
  id String @id @default(uuid())

  completedByName  String?
  completedByEmail String?
  ownerName        String?
  ownerEmail       String?

  companyName      String
  tradingAs        String?
  companyRegNumber String
  vatNumber        String?

  physicalAddress String
  lat             Float?
  lng             Float?

  mibcoNumber  String?
  rmiNumber    String
  sambraNumber String?
  miwaNumber   String?

  /// Legacy flat rates, superseded by rate cards. No longer on any form.
  labourRateSenior Decimal? @db.Decimal(12, 2)
  labourRateJunior Decimal? @db.Decimal(12, 2)

  logoUrl String?
  email   String?
  phone   String?

  active            Boolean           @default(true)
  status            PanelBeaterStatus @default(pending)
  submittedByPublic Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards   RateCard[]
  agreements  RepairerAgreement[]
  warranties  Warranty[]
  users       User[]
  quotes      Quote[]
  selectedFor RequestPanelBeater[]

  @@index([active, status])
  @@index([companyName])
  @@map("panel_beaters")
}

/// A manufacturer warranty approval held by a panel beater.
model Warranty {
  id            String @id @default(uuid())
  panelBeaterId String

  manufacturer String
  startDate    DateTime? @db.Date
  expiryDate   DateTime? @db.Date

  /// Certificate lives in Blob; these are the proxy URL + blob pathname.
  certificateUrl         String?
  certificatePathname    String?
  certificateContentType String?

  remind Boolean @default(false)
  /// Reminder milestones already emailed: "3m","2m","1m","2w","1d".
  remindersSent String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelBeater PanelBeater @relation(fields: [panelBeaterId], references: [id], onDelete: Cascade)

  @@index([panelBeaterId])
  @@index([expiryDate])
  @@map("warranties")
}

// ---- Suppliers -------------------------------------------------------------

model Supplier {
  id        String     @id @default(uuid())
  name      String
  partTypes PartType[]
  makes     String[]
  supplies  String?
  email     String?
  phone     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active])
  @@map("suppliers")
}

// ---- Quote requests --------------------------------------------------------

model QuoteRequest {
  id        String        @id @default(uuid())
  reference String        @unique
  status    RequestStatus @default(new)

  /// Unguessable key for the consumer's own "your quotes" page. The reference
  /// (PMP-date-SURNAME-nn) is predictable, so it can't be what gates access.
  publicToken String? @unique

  /// Rate card the repairer chose when they opened the job. Drives the rates
  /// the quote builder starts from.
  rateCardId String?

  // Consumer
  firstName   String
  lastName    String
  email       String
  phone       String
  companyName String?

  hasInsurance          YesNo
  insurerName           String?
  insurerId             String?
  underWarranty         YesNoUnsure
  isInsuranceClaim      YesNo
  claimNumber           String?
  noClaimNumberYet      Boolean     @default(false)
  isThirdPartyClaim     YesNo
  suspectedEngineDamage YesNo
  quotesRequested       Int         @default(1)

  // Vehicle — flattened into columns so BI can slice on them directly.
  vin          String?
  make         String?
  model        String?
  series       String?
  year         String?
  colour       String?
  registration String?
  /// Raw OCR text off the licence disc — opaque, for the assessor only.
  discRawText  String?

  mileageKm Int?

  /// True when a panel beater started this quote themselves (not a consumer).
  repairerInitiated Boolean @default(false)

  // Where the consumer was when they submitted.
  lat Float?
  lng Float?
  /// True when the client asked us to pick the workshops for them.
  letUsChoose Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insurer              Insurer?             @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  rateCard             RateCard?            @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  media                RequestMedia[]
  selectedPanelBeaters RequestPanelBeater[]
  quotes               Quote[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([insurerId])
  @@index([email])
  @@index([lastName])
  @@map("quote_requests")
}

/// Media attached to a request. One row per file; bytes stay in Blob.
model RequestMedia {
  id        String    @id @default(uuid())
  requestId String
  kind      MediaKind

  url         String
  pathname    String
  contentType String?
  /// Ordering within a multi-file kind (damage photos).
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  request QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, kind])
  @@map("request_media")
}

/// Which panel beaters the consumer picked for a request.
model RequestPanelBeater {
  requestId     String
  panelBeaterId String

  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  panelBeater PanelBeater  @relation(fields: [panelBeaterId], references: [id], onDelete: Cascade)

  @@id([requestId, panelBeaterId])
  @@index([panelBeaterId])
  @@map("request_panel_beaters")
}

// ---- Built quotes ----------------------------------------------------------

model Quote {
  id            String @id @default(uuid())
  requestId     String
  panelBeaterId String

  /// The resolved rand amount, however it was entered. Everything downstream
  /// (PDF, totals, BI) reads this and needs to know nothing about percentages.
  sundries        Decimal  @default(0) @db.Decimal(12, 2)
  /// Set only when sundries were entered as a % OF PARTS, so reopening the
  /// quote shows the estimator the percentage they actually typed.
  sundriesPercent Decimal? @db.Decimal(6, 2)
  consumables     Decimal  @default(0) @db.Decimal(12, 2)

  partsTotal  Decimal @default(0) @db.Decimal(12, 2)
  /// Work sent out to a third party. Priced in the same money box on the line
  /// as a part, but deliberately totalled apart: it is not stock the repairer
  /// bought, and bundling it into parts hid it from them.
  outWorkTotal Decimal @default(0) @db.Decimal(12, 2)
  panelTotal  Decimal @default(0) @db.Decimal(12, 2)
  paintTotal  Decimal @default(0) @db.Decimal(12, 2)
  stripTotal  Decimal @default(0) @db.Decimal(12, 2)
  labourTotal Decimal @default(0) @db.Decimal(12, 2)
  totalHours  Decimal @default(0) @db.Decimal(10, 2)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  vat      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes         String?
  estimatorName String?
  pdfUrl        String?
  createdByName String?

  status     QuoteStatus @default(awaiting_approval)
  /// When the consumer accepted this quote. Null unless status is accepted.
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request     QuoteRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  panelBeater PanelBeater     @relation(fields: [panelBeaterId], references: [id])
  lines       QuoteLineItem[]

  /// One quote per workshop per request.
  @@unique([requestId, panelBeaterId])
  @@index([panelBeaterId])
  @@index([createdAt(sort: Desc)])
  @@map("quotes")
}

model QuoteLineItem {
  id        String @id @default(uuid())
  quoteId   String
  sortOrder Int    @default(0)

  /// New / Alt / Used / Repair / Out Work / Paint / Note (free text).
  code        String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  /// What the part cost the workshop, before mark-up. Optional: a line may be
  /// priced directly without recording a cost.
  partsCost   Decimal? @db.Decimal(12, 2)
  /// What the part is CHARGED at — cost plus the card's mark-up for its type.
  partsAmount Decimal  @default(0) @db.Decimal(12, 2)

  // Legacy parts-catalogue link (the catalogue itself is gone).
  partId     String?
  supplier   String?
  partNumber String?

  panelCode   String?
  panelAmount Decimal @default(0) @db.Decimal(12, 2)
  panelHours  Decimal @default(0) @db.Decimal(10, 2)

  paintCode   String?
  paintAmount Decimal @default(0) @db.Decimal(12, 2)
  paintHours  Decimal @default(0) @db.Decimal(10, 2)

  stripCode   String?
  stripAmount Decimal @default(0) @db.Decimal(12, 2)
  stripHours  Decimal @default(0) @db.Decimal(10, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_line_items")
}

// ---- Reference allocation --------------------------------------------------

/// Per-day counter behind PMP-YYYYMMDD-SURNAME-NN. Incremented atomically in
/// the database, so concurrent submissions can no longer collide.
model ReferenceCounter {
  dateKey String @id
  seq     Int    @default(0)

  @@map("reference_counters")
}

// ---- Dev planner -----------------------------------------------------------

/// How badly a dev ticket is wanted. Three levels on purpose: the whole point
/// is to separate "drop everything" from "we have committed to this" from
/// "only if there's time", and a fourth level would blur those.
enum DevPriority {
  urgent
  must_do
  nice_to_have
}

enum DevTicketStatus {
  backlog
  in_progress
  done
}

/// A unit of development work. Author and creation time are stamped from the
/// SESSION, never the request body, so "who asked for this" survives the person
/// later being deleted (createdByName is a copy, not a join).
model DevTicket {
  id       String @id @default(uuid())
  title    String
  /// Freeform. What's wanted and why — the "why" is the part that rots.
  detail   String?

  priority DevPriority     @default(must_do)
  status   DevTicketStatus @default(backlog)

  /// Optional nudge. `reminderSentAt` is what stops the daily cron sending the
  /// same reminder every morning once the date has passed.
  remindOn       DateTime? @db.Date
  reminderSentAt DateTime?

  /// Who loaded it. The id may dangle if the user is deleted; the name is kept
  /// verbatim so the ticket still tells you who wanted it.
  createdById   String?
  createdByName String
  createdByEmail String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  attachments DevTicketAttachment[]
  notes       DevTicketNote[]

  @@index([status, priority])
  @@index([remindOn])
  @@map("dev_tickets")
}

/// A third-party credential entered in the portal rather than set as a Vercel
/// env var. The value is AES-256-GCM ciphertext (see lib/secrets.ts) — never
/// the key itself — because Power BI reads this database directly and a live
/// billable credential must not travel there in readable form.
model IntegrationSecret {
  /// Stable name, e.g. "imagin8". One row per integration.
  id String @id

  /// The non-secret half of the pair (imagin8 issue a client ID alongside the
  /// key). Stored in the clear on purpose: it is an identifier, not a
  /// credential, and showing it is how an admin confirms WHICH account is
  /// wired up without having to reveal the secret.
  clientId String?

  ciphertext String
  iv         String
  authTag    String

  /// Enough to confirm WHICH key is loaded without revealing it.
  masked String

  /// Who last changed it. A verbatim copy, like the dev-planner author, so a
  /// deleted user doesn't erase the audit trail on a billable credential.
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@map("integration_secrets")
}

/// A decoded VIN, cached. imagin8 bills per transaction, so re-opening a quote,
/// rebuilding it, or an assessor reviewing it must never re-charge us for a VIN
/// already looked up. `raw` keeps the untouched vendor payload so new fields can
/// be surfaced later without paying to fetch them again.
model VinLookup {
  vin String @id

  make        String?
  model       String?
  series      String?
  year        String?
  /// Mead & McGrouther code — the industry key Carl asked for by name.
  mmCode      String?
  retailValue Decimal? @db.Decimal(12, 2)
  tradeValue  Decimal? @db.Decimal(12, 2)
  marketValue Decimal? @db.Decimal(12, 2)

  raw Json?

  /// False when the vendor had no record, so a miss is cached too and a VIN
  /// they cannot decode isn't retried (and re-billed) on every page load.
  found Boolean @default(true)

  fetchedAt DateTime @default(now())

  @@map("vin_lookups")
}

/// A comment on a ticket — the running conversation about the work, kept apart
/// from `detail` so the original ask is never overwritten by a later remark.
/// Notes are append-only in the UI: you may delete your own, never rewrite one,
/// because a thread you can silently edit is not a record of anything.
model DevTicketNote {
  id       String @id @default(uuid())
  ticketId String

  body String

  /// Same arrangement as the ticket's author: the id may dangle if the user is
  /// deleted, the name is a verbatim COPY so the note still says who wrote it.
  createdById    String?
  createdByName  String
  createdByEmail String?

  createdAt DateTime @default(now())

  ticket DevTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("dev_ticket_notes")
}

/// A document or image pinned to a ticket. Same arrangement as RequestMedia:
/// the bytes live in a private Blob store, this row holds the pathname and the
/// /api/media proxy URL.
model DevTicketAttachment {
  id       String @id @default(uuid())
  ticketId String

  /// The name the file had on the uploader's machine, shown in the list.
  fileName    String
  url         String
  pathname    String
  contentType String?
  size        Int?

  createdAt DateTime @default(now())

  ticket DevTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("dev_ticket_attachments")
}
